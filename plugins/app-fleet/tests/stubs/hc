#!/usr/bin/env python3
# Test stub for hc: logs argv and answers like the real CLI.
#   get <t>   $STUB_DIR/hc.get.out if present; else finished when <t> is listed in hc.dead;
#             else live, with an idle claude status (no `app` when <t> is listed in hc.noapp).
#   run       a new address tm<N>; fails on call number $STUB_HC_RUN_FAIL_AT.
#   ls        the terminals `run` started plus the "address name" lines in hc.ls.extra.
#   get also reports `foreground` (claude, or zsh when listed in hc.shell or hc.noapp) and `parent`
#   (from hc.parents, which `run` appends to).
import json, os, sys
log = os.environ.get("STUB_LOG"); d = os.environ.get("STUB_DIR", "/tmp")
os.makedirs(d, exist_ok=True)
a = sys.argv[1:]
if log:
    with open(log, "a") as fh: fh.write("hc " + " ".join(a) + "\n")
def lines(name):
    try:
        return [x.split() for x in open(os.path.join(d, name)).read().splitlines() if x.strip()]
    except OSError:
        return []
def listed(name, t):
    return any(x and x[0] == t for x in lines(name))
cmd = a[0] if a else ""
if cmd == "kill":
    sys.exit(int(os.environ.get("STUB_HC_KILL_STATUS", "0")))
if cmd == "get":
    t = a[1] if len(a) > 1 else ""
    out = os.path.join(d, "hc.get.out")
    if os.path.exists(out):
        print(open(out).read().strip())
    elif listed("hc.dead", t):
        print(json.dumps({"address": t, "state": "finished", "status": None}))
    else:
        st = {"state": "idle"} if listed("hc.noapp", t) else {"app": "claude-code", "state": "idle"}
        fg = "/bin/zsh" if listed("hc.noapp", t) or listed("hc.shell", t) else "claude"
        parent = next((x[1] for x in lines("hc.parents") if x[0] == t and len(x) > 1), None)
        print(json.dumps({"address": t, "state": "live", "status": st, "foreground": {"argv": [fg]}, "parent": parent}))
    sys.exit(0)
if cmd == "run":
    n_path = os.path.join(d, "hc.n")
    n = int(open(n_path).read()) + 1 if os.path.exists(n_path) else 1
    open(n_path, "w").write(str(n))
    if str(n) == os.environ.get("STUB_HC_RUN_FAIL_AT", ""):
        print("hc: stub failure for run", file=sys.stderr); sys.exit(1)
    name = a[a.index("--name") + 1] if "--name" in a else ""
    addr = f"tm{n}"
    with open(os.path.join(d, "hc.names"), "a") as fh: fh.write(f"{addr} {name or '-'}\n")
    if "--parent" in a:
        with open(os.path.join(d, "hc.parents"), "a") as fh: fh.write(f"{addr} {a[a.index('--parent') + 1]}\n")
    print(json.dumps({"address": addr, "name": name or None, "state": "live"}))
    sys.exit(0)
if cmd == "ls":
    ts = [{"address": x[0], "name": None if len(x) < 2 or x[1] == "-" else x[1], "state": "live"}
          for x in lines("hc.names") + lines("hc.ls.extra") if not listed("hc.dead", x[0])]
    print(json.dumps({"terminals": ts}))
    sys.exit(0)
sys.exit(0)
